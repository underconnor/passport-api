generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Subject {
  id String @id @default(uuid()) @db.Uuid
  universityKey String @unique
  displayName String
  identityProvider String
  department String @default("")
  academicStatus String @default("UNKNOWN")
  admissionYear String? @db.VarChar(2)
  statisticsEnabled Boolean @default(true)
  statisticsRevision Int @default(1)
  studentIdCiphertext String?
  universityExpiryPolicyVersion Int @default(0)
  universityVerifiedAt DateTime?
  universityVerifiedUntil DateTime?
  accessSuspended Boolean @default(false)
  scopeRestricted Boolean @default(false)
  scopeLimit String[] @default([])
  membershipStatus String @default("inactive")
  roleLabel String @default("")
  verifiedUntil DateTime
  allowedServerIds String[] @default([])
  discordId String?
  discordUpdatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions WebSession[]
  minecraft MinecraftIdentity?
  links LinkSession[]
  administrator Administrator?
  consents ConsentReceipt[]
  discordIdentity DiscordIdentity?
  discordLinks DiscordLinkSession[]
  membershipSemesters MembershipSemester[]
  activityGenerations ActivityGeneration[]
  operatorInvitations OperatorInvitation[] @relation("InvitationTarget")
  issuedOperatorInvitations OperatorInvitation[] @relation("InvitationIssuer")
}
model WebSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  subjectId String? @db.Uuid
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  audienceHost String
  expiresAt DateTime
  createdAt DateTime @default(now())
  confirmedLinks LinkSession[]
  universityRequests UniversityAuthRequest[]
  mfaVerifiedUntil DateTime?
  @@index([expiresAt])
}
model MinecraftIdentity {
  uuid String @id @db.Uuid
  name String
  subjectId String? @unique @db.Uuid
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  policyVersion Int @default(1)
  policyFingerprint String @default("")
  telemetryEpoch String @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model LinkSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  minecraftUuid String @db.Uuid
  minecraftName String
  gameSessionHash String
  status String @default("pending")
  subjectId String? @db.Uuid
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  webSessionId String? @db.Uuid
  webSession WebSession? @relation(fields: [webSessionId], references: [id], onDelete: SetNull)
  webConfirmedAt DateTime?
  gameConfirmedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([minecraftUuid, status])
  @@index([expiresAt])
}
model PolicyEvent {
  id BigInt @id @default(autoincrement())
  minecraftUuid String @db.Uuid
  policyVersion Int
  createdAt DateTime @default(now())
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  action String
  subjectId String? @db.Uuid
  objectId String?
  actorSubjectId String? @db.Uuid
  details Json?
  createdAt DateTime @default(now())
}
model UniversityAuthRequest {
  id String @id @default(uuid()) @db.Uuid
  stateHash String @unique
  webSessionId String @db.Uuid
  webSession WebSession @relation(fields: [webSessionId], references: [id], onDelete: Cascade)
  returnContext String?
  consentVersion String?
  consentAcceptedAt DateTime?
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model ConsentReceipt {
  id String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  version String
  source String
  contextId String @db.Uuid
  acceptedAt DateTime
  createdAt DateTime @default(now())
  @@unique([subjectId, version, source, contextId])
  @@index([subjectId, version, acceptedAt])
}
model ConsumedUniversityToken {
  tokenHash String @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
}
model Administrator {
  subjectId String @id @db.Uuid
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  totpSecret String
  enabled Boolean @default(false)
  role String @default("viewer")
  revokedAt DateTime?
  lastTotpStep BigInt @default(-1)
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model OperatorInvitation {
  id String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid
  subject Subject @relation("InvitationTarget", fields: [subjectId], references: [id], onDelete: Cascade)
  issuerSubjectId String @db.Uuid
  issuer Subject @relation("InvitationIssuer", fields: [issuerSubjectId], references: [id], onDelete: Cascade)
  role String
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  revokedAt DateTime?
  @@index([subjectId, status])
  @@index([issuerSubjectId, status])
}
model RosterSnapshot {
  id String @id
  sourceKey String
  digest String
  fetchedAt DateTime
  expiresAt DateTime
  entryCount Int
  updatedAt DateTime @updatedAt
  entries RosterMembership[]
}
model RosterMembership {
  studentKey String @id
  status String
  roleLabel String
  serverIds String[] @default([])
  snapshotId String
  snapshot RosterSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}
model ServerRecord {
  id String @id
  commandName String @unique
  label String
  sensitive Boolean @default(false)
  enabled Boolean @default(false)
  accessMode String @default("members")
  discordRequirement String @default("any")
  statisticsEnabled Boolean @default(true)
  allowedSubjectIds String[] @default([]) @db.Uuid
  paperSeenAt DateTime?
  proxySeenAt DateTime?
  createdAt DateTime @default(now())
  // Heartbeats must not change the optimistic settings revision.
  updatedAt DateTime @default(now())
}
model DiscordIdentity {
  discordUserId String @id
  guildId String
  username String
  displayName String
  subjectId String? @unique @db.Uuid
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  verifiedAt DateTime
  eraseWhenRevoked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles DiscordRoleState[]
  nicknames DiscordNicknameState[]
}
model DiscordLinkSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  interactionHash String @unique
  discordUserId String
  guildId String
  username String
  displayName String
  subjectId String? @db.Uuid
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([discordUserId, guildId, status])
  @@index([expiresAt])
}
model DiscordRoleState {
  id String @id @default(uuid()) @db.Uuid
  discordUserId String
  identity DiscordIdentity @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)
  guildId String
  roleId String
  kind String @default("verification")
  semester String?
  desired Boolean
  version BigInt @default(1)
  validUntil DateTime?
  appliedDesired Boolean?
  appliedVersion BigInt?
  appliedAt DateTime?
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  lastError String?
  leaseHash String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([discordUserId, guildId, roleId])
  @@index([nextAttemptAt, leaseUntil])
  @@index([desired, validUntil])
}
model DiscordGuildSettings {
  guildId String @id
  verificationRoleId String
  memberRoleId String?
  currentSemester String?
  nicknameEnabled Boolean @default(false)
  revision BigInt @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  semesterRoles DiscordSemesterRole[]
}
model DiscordSemesterRole {
  guildId String
  settings DiscordGuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  semester String
  roleId String
  @@id([guildId, semester])
  @@unique([guildId, roleId])
}
model MembershipSemester {
  subjectId String @db.Uuid
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  guildId String
  semester String
  recordedAt DateTime @default(now())
  @@id([subjectId, guildId, semester])
}
model DiscordNicknameState {
  id String @id @default(uuid()) @db.Uuid
  discordUserId String
  identity DiscordIdentity @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)
  guildId String
  nickname String?
  version BigInt @default(1)
  validUntil DateTime?
  appliedNickname String?
  appliedVersion BigInt?
  appliedAt DateTime?
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  lastError String?
  leaseHash String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([discordUserId, guildId])
  @@index([nextAttemptAt, leaseUntil])
}

model PlayerPresence {
  minecraftUuid String @id @db.Uuid
  serverId String
  observedAt DateTime
  expiresAt DateTime
  @@index([expiresAt])
}
model ActivityGeneration {
  epoch String @id @db.Uuid
  subjectId String @db.Uuid
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  minecraftUuid String @db.Uuid
  createdAt DateTime @default(now())
  totals ActivityTotal[]
  daily ActivityDaily[]
  @@index([subjectId])
}
model ActivityTotal {
  epoch String @db.Uuid
  generation ActivityGeneration @relation(fields: [epoch], references: [epoch], onDelete: Cascade)
  serverId String
  playSeconds BigInt @default(0)
  blocksBroken BigInt @default(0)
  blocksPlaced BigInt @default(0)
  damageTakenMilli BigInt @default(0)
  deaths BigInt @default(0)
  mobKills BigInt @default(0)
  playerKills BigInt @default(0)
  distanceCm BigInt @default(0)
  firstCollectedAt DateTime?
  lastCollectedAt DateTime?
  @@id([epoch, serverId])
}
model ActivityBatch {
  id String @id @db.Uuid
  digest String
  received Int
  ignored Int
  createdAt DateTime @default(now())
}

// Daily buckets start at rollout; old cumulative records are never backfilled.
model ActivityDaily {
  epoch String @db.Uuid
  generation ActivityGeneration @relation(fields: [epoch], references: [epoch], onDelete: Cascade)
  serverId String
  date DateTime @db.Date
  playSeconds BigInt @default(0)
  blocksBroken BigInt @default(0)
  blocksPlaced BigInt @default(0)
  damageTakenMilli BigInt @default(0)
  deaths BigInt @default(0)
  mobKills BigInt @default(0)
  playerKills BigInt @default(0)
  distanceCm BigInt @default(0)
  firstCollectedAt DateTime
  lastCollectedAt DateTime
  @@id([epoch, serverId, date])
  @@index([date, serverId])
}
model StatisticsHistory {
  id String @id @default("main")
  availableFrom DateTime @default(now())
}
model ManualSettings {
  id String @id @default("main")
  notionUrl String?
  embedUrl String?
  title String @default("매뉴얼")
  revision Int @default(1)
  updatedAt DateTime @updatedAt
}

model ServiceCredential {
  id String @id @default(uuid()) @db.Uuid
  serviceId String
  audience String
  tokenHash String @unique
  scopes String[]
  serverIds String[]
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([serviceId, createdAt])
}
