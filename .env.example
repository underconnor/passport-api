NODE_ENV=development
PASSPORT_AUTH_MODE=university-disabled
DATABASE_URL=postgresql://passport:replace-locally@127.0.0.1:5432/passport
API_SERVICE_TOKEN=replace-with-independent-random-32-byte-token
SESSION_SECRET=replace-with-another-random-32-byte-token
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
BIND_HOST=127.0.0.1
PORT=3000
# Set to 2 only when the API has no direct host port and is behind Caddy -> nginx.
TRUST_PROXY_HOPS=0
SERVER_REGISTRY_JSON=[{"id":"lobby","label":"로비"},{"id":"survival","label":"야생"}]
# Real deployment: set NODE_ENV=production and PASSPORT_AUTH_MODE=university.
# WEB_ORIGIN and ADMIN_ORIGIN must be separate HTTPS hosts.
ROSTER_MATCHING_SECRET=
# Generate 32 random bytes as 64 hexadecimal characters, separately from other secrets.
DATA_ENCRYPTION_KEY=
# Generate 32 random bytes as base64url; required only for first administrator enrollment.
ADMIN_BOOTSTRAP_TOKEN=
# Defaults to true. false still requires a registered administrator and valid school login.
ADMIN_MFA_REQUIRED=true
SHEETS_SYNC_ENABLED=false
# public-query reads only explicitly selected student/enrollment columns.
SHEETS_ACCESS_MODE=public-query
SHEETS_SPREADSHEET_ID=
SHEETS_TAB=
SHEETS_ACADEMIC_STATUS_HEADER=
ROSTER_ACTIVE_ACADEMIC_STATUSES_JSON=["재학","휴학"]
ROSTER_DEFAULT_SERVER_IDS_JSON=["lobby"]
SHEETS_SYNC_INTERVAL_SECONDS=60
ROSTER_MAX_AGE_SECONDS=900

# Optional Discord bot integration: configure all three together with an independent secret.
PASSPORT_DISCORD_SERVICE_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=
